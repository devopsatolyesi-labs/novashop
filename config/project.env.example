# NovaShop DevOps Store — Proje Konfigürasyon Örneği
# Bu dosya gizli bilgi içermez; örnek ve varsayılan değerleri tanımlar.

NOVASHOP_NAME="NovaShop DevOps Store"
NOVASHOP_DOMAIN="novashop.devopsatolyesi.com"
UPSTREAM_REPOSITORY="https://github.com/aws-containers/retail-store-sample-app"
UPSTREAM_RELEASE="v1.6.2"
UPSTREAM_COMMIT_SHA="1a28474f2461459f42e6b393db59e7d1434d4aec"
AWS_REGION="eu-central-1"

# Servis ve Ağ Yapılandırması
UI_PORT="8888"
SEARCH_ENABLED="false"
RETAIL_UI_CHAT_ENABLED="false"
RETAIL_UI_THEME="default"
