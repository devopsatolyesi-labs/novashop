# ==============================================================================
# NovaShop LAB-05: GitHub Actions CI/CD, AWS ECR ve EC2 Dağıtım Değişkenleri
# ==============================================================================
# Kullanım:
#   1. cp .env.example .env
#   2. nano .env  # Kendi AWS, GitHub ve EC2 değerlerinizi girin
#   3. set -a && source .env && set +a  # Ortam değişkenlerini oturuma aktarın
# ==============================================================================

# --- 1. AWS Hesap ve Bölge Parametreleri ---
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012

# Opsiyonel: CLI için yerel AWS kimlikleri (CloudShell veya ~/.aws/credentials yoksa)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- 2. GitHub Bilgileri ---
GITHUB_ORG_OR_USER=devops-ogrenci
GITHUB_REPO_NAME=novashop

# --- 3. AWS ECR ve IAM Rolü ---
ECR_REPO_NAME=novashop-ui
ROLE_NAME=novashop-github-actions-role

# Otomatik Türetilen Değerler
ROLE_ARN=arn:aws:iam://${AWS_ACCOUNT_ID}:role/${ROLE_NAME}
ECR_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}

# --- 4. EC2 Sunucu Bilgileri (Dağıtım Hedefi) ---
EC2_PUBLIC_IP=3.120.45.67
EC2_USER=ubuntu
KEY_PATH=~/.ssh/novashop-key.pem

# --- 5. RDS MySQL Parametreleri (LAB-04 ile uyumlu) ---
RDS_ENDPOINT=novashop-catalog-db.cxxxx.rds.amazonaws.com
DB_PORT=3306
DB_NAME=catalogdb
DB_USER=novashop
DB_PASSWORD=ChangeMeStrongPassword123!
DB_ENDPOINT=${RDS_ENDPOINT}:${DB_PORT}
